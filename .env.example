# Copy to .env.local for local work, or add these in your host's "Environment Variables" screen. NEVER commit real keys.
# Server-side only: these are read by api/reception.js and are never bundled into the website.
AI_PROVIDER=anthropic        # anthropic | openai (openai = any OpenAI-compatible chat-completions API)
AI_API_KEY=your-secret-key-here
AI_MODEL=your-model-name-here
# AI_BASE_URL=               # optional: override the provider base URL (gateway / compatible service)
